# .env.example
# BSM Automatic SFTP Backup System
# Developed by Basil Saji Mathew (BSM)

# Global Settings
NODE_ENV=production
LOG_LEVEL=info

# Discord Webhook Notification
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
ENABLE_DISCORD=true

# Encryption Settings
ENCRYPTION_KEY=BSM_SECRET_KEY_32_CHARS_LNGTH1234
ENCRYPTION_ALGORITHM=aes-256-cbc

# Database Credentials
DB_USER_MYSQL=root
DB_PASS_MYSQL=password123
DB_USER_POSTGRES=postgres
DB_PASS_POSTGRES=postgres123
DB_URI_MONGO=mongodb://localhost:27017/admin

# Advanced Retention Policy Settings (Defaults applied via config/backup.yml otherwise)
MAX_RETENTION_DAYS=30
MAX_BACKUP_SIZE_MB=5000
